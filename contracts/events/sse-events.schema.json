{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify-agent.local/events/sse-events.schema.json",
  "title": "StreamEvent",
  "oneOf": [
    { "$ref": "#/$defs/messageStarted" },
    { "$ref": "#/$defs/toolStarted" },
    { "$ref": "#/$defs/toolCompleted" },
    { "$ref": "#/$defs/answerDelta" },
    { "$ref": "#/$defs/citationAvailable" },
    { "$ref": "#/$defs/messageCompleted" },
    { "$ref": "#/$defs/messageFailed" }
  ],
  "$defs": {
    "baseProperties": {
      "requestId": { "type": "string", "minLength": 1 },
      "conversationId": { "type": "string", "minLength": 1 },
      "timestamp": { "type": "string", "format": "date-time" }
    },
    "messageStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "conversationId", "timestamp", "messageId"],
      "properties": {
        "type": { "const": "message.started" },
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "messageId": { "type": "string", "minLength": 1 }
      }
    },
    "toolStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "conversationId", "timestamp", "toolCallId", "tool"],
      "properties": {
        "type": { "const": "tool.started" },
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "toolCallId": { "type": "string", "minLength": 1 },
        "tool": {
          "type": "string",
          "enum": [
            "graphify.search",
            "graphify.get_node",
            "graphify.get_neighbors",
            "graphify.shortest_path"
          ]
        }
      }
    },
    "toolCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "conversationId", "timestamp", "toolCallId", "tool", "summary"],
      "properties": {
        "type": { "const": "tool.completed" },
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "toolCallId": { "type": "string", "minLength": 1 },
        "tool": {
          "type": "string",
          "enum": [
            "graphify.search",
            "graphify.get_node",
            "graphify.get_neighbors",
            "graphify.shortest_path"
          ]
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeCount", "edgeCount", "truncated"],
          "properties": {
            "nodeCount": { "type": "integer", "minimum": 0 },
            "edgeCount": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" }
          }
        }
      }
    },
    "answerDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "conversationId", "timestamp", "delta"],
      "properties": {
        "type": { "const": "answer.delta" },
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "delta": { "type": "string", "minLength": 1 }
      }
    },
    "citationAvailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "conversationId", "timestamp", "citation"],
      "properties": {
        "type": { "const": "citation.available" },
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "citation": { "$ref": "../schemas/answer.schema.json#/$defs/citation" }
      }
    },
    "messageCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "conversationId", "timestamp", "result"],
      "properties": {
        "type": { "const": "message.completed" },
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "result": { "$ref": "../schemas/answer.schema.json" }
      }
    },
    "messageFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "conversationId", "timestamp", "error"],
      "properties": {
        "type": { "const": "message.failed" },
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "graphify_unavailable",
                "mcp_timeout",
                "llm_unavailable",
                "invalid_model_response",
                "request_timeout",
                "invalid_request",
                "stream_interrupted",
                "internal_error"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
