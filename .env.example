# Copy to .env. The default runtime is the real open-source Graphify server.
COMPOSE_PROJECT_NAME=graphify-agent-poc
GRAPHIFY_RUNTIME_MODE=real
GRAPHIFY_PACKAGE_VERSION=0.9.18

# LLM provider (server-side only; never prefix these with NEXT_PUBLIC_)
# `mock` makes answer generation deterministic while the default graph runtime
# remains real. Set `litellm` for provider-backed answers; neither adapter ever
# falls back to its mock after a runtime failure.
LLM_ADAPTER=mock
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Graphify MCP adapter
GRAPHIFY_ADAPTER=mcp
GRAPHIFY_MCP_TRANSPORT=http
GRAPHIFY_MCP_URL=http://graphify:8001/mcp
GRAPHIFY_PROJECT_ID=sample-project
GRAPHIFY_PROJECT_PATH=/knowledge/graph/active
GRAPHIFY_KNOWLEDGE_ROOT=/knowledge
GRAPHIFY_REQUEST_TIMEOUT_SECONDS=20
GRAPHIFY_SEARCH_TOOL=query_graph
GRAPHIFY_GET_NODE_TOOL=get_node
GRAPHIFY_GET_NEIGHBORS_TOOL=get_neighbors
GRAPHIFY_SHORTEST_PATH_TOOL=shortest_path

# Bounded agent settings
AGENT_REQUEST_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_TRAVERSAL_DEPTH=2
AGENT_MAX_NODES=100
AGENT_MAX_EDGES=200
AGENT_MAX_EVIDENCE_BYTES=65536
AGENT_MAX_MODEL_ITERATIONS=2
AGENT_RESPONSE_LANGUAGE_MODE=match-user
AGENT_DEFAULT_LANGUAGE=es

# Durable conversation state. SQLite is the default single-API POC backend.
CONVERSATION_DATABASE_URL=sqlite+aiosqlite:////knowledge/state/conversations.db
CONVERSATION_RETENTION_DAYS=30
CONVERSATION_MAX_TURNS=100
CONVERSATION_HISTORY_MAX_TURNS=6
CONVERSATION_HISTORY_MAX_CHARS=8000
CONVERSATION_REQUEST_LEASE_SECONDS=300
CONVERSATION_CLEANUP_INTERVAL_SECONDS=3600

# Real Graphify extraction. Graphify 0.9.18 consumes provider-specific
# environment variables during extraction.
GRAPHIFY_EXTRACT_BACKEND=openai
GRAPHIFY_EXTRACT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Persistent input, staging, graph, failure, and state boundaries.
KNOWLEDGE_INPUT_DIR=/knowledge/input
KNOWLEDGE_STAGING_DIR=/knowledge/staging
KNOWLEDGE_GRAPH_DIR=/knowledge/graph
KNOWLEDGE_ARCHIVE_DIR=/knowledge/archive
KNOWLEDGE_FAILED_DIR=/knowledge/failed
KNOWLEDGE_MANIFEST_PATH=/knowledge/state/manifest.json
KNOWLEDGE_SOURCE_INDEX_PATH=/knowledge/state/source-index.sqlite
KNOWLEDGE_INGEST_ON_STARTUP=true
KNOWLEDGE_FORCE_REBUILD=false
KNOWLEDGE_ADMIN_ENDPOINTS_ENABLED=true
KNOWLEDGE_MAX_DOCUMENT_SIZE_BYTES=2097152
KNOWLEDGE_MAX_DOCUMENT_COUNT=100
KNOWLEDGE_MAX_TOTAL_SOURCE_BYTES=33554432
KNOWLEDGE_MAX_EXTRACTED_DOCUMENT_BYTES=8388608
# Ordered structural document profiles (JSON). Omit to use the legal-es/generic defaults.
# KNOWLEDGE_DOCUMENT_PROFILES_JSON={"version":1,"defaultProfile":"generic","rules":[],"profiles":{"generic":{"hardBoundaries":["page","markdown_heading"],"leafTokens":256,"parentTokens":768,"overlapTokens":32,"autoMergeThreshold":0.5}}}
KNOWLEDGE_GRAPH_VERSIONS_TO_KEEP=2
KNOWLEDGE_BUILD_TIMEOUT_SECONDS=1800

# Next.js server-side API proxy. The browser uses same-origin `/api/*` routes.
API_INTERNAL_URL=http://api:8000
LOG_LEVEL=INFO

# Explicit deterministic troubleshooting mode:
# docker compose -f docker-compose.yml -f docker-compose.synthetic.yml up --build
