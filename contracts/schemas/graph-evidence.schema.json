{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphify-agent.local/schemas/graph-evidence.schema.json",
  "title": "GraphEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges", "paths"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": ["explicit", "extracted", "inferred", "unknown"]
    },
    "scalarProperties": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "properties": { "$ref": "#/$defs/scalarProperties" },
        "source": { "type": ["string", "null"] },
        "excerpt": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceNodeId",
        "targetNodeId",
        "relationship",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceNodeId": { "type": "string", "minLength": 1 },
        "targetNodeId": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 },
        "properties": { "$ref": "#/$defs/scalarProperties" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeIds", "edgeIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "edgeIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
