        <mxCell id="gInv" value="Key invariants (from AGENTS.md / ADRs)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fontStyle=1;fontSize=13;fillColor=#EEEEEE;strokeColor=#666666;swimlaneFillColor=#FAFAFA;rounded=1;arcSize=3;collapsible=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="720" width="500" height="380" as="geometry" />
        </mxCell>
        <mxCell id="inv_text" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;&lt;b&gt;Graph-first grounding:&lt;/b&gt; Graphify defines the allowed documents/articles; Haystack may only narrow that scope, never broaden it.&lt;/li&gt;&lt;li&gt;Relationship claims need graph evidence; textual/legal claims need exact source passages (document · article · paragraph · line).&lt;/li&gt;&lt;li&gt;Model citation IDs must match the request allowlist; insufficient evidence ⇒ explicit insufficient-evidence answer.&lt;/li&gt;&lt;li&gt;Conversation history is untrusted context; fresh evidence on every answer.&lt;/li&gt;&lt;li&gt;Browser never receives provider/Graphify credentials, raw MCP payloads, prompts or hidden reasoning.&lt;/li&gt;&lt;li&gt;Every SSE request ends in exactly one &lt;i&gt;message.completed&lt;/i&gt; or &lt;i&gt;message.failed&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;Ingestion = control plane (writer worker); chat = query plane (request-bound, version-pinned, read-only).&lt;/li&gt;&lt;li&gt;Immutable snapshots + atomic activation; a failed build never replaces the active graph/index.&lt;/li&gt;&lt;li&gt;Contract changes update backend models, contracts/, Zod types, tests and docs together (ADR for breaking changes).&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="gInv">
          <mxGeometry x="15" y="35" width="470" height="335" as="geometry" />
        </mxCell>
        <mxCell id="gComp" value="Docker Compose runtime (docker-compose.yml)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fontStyle=1;fontSize=13;fillColor=#EEEEEE;strokeColor=#666666;swimlaneFillColor=#FAFAFA;rounded=1;arcSize=3;collapsible=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1810" y="60" width="430" height="380" as="geometry" />
        </mxCell>
        <mxCell id="comp_text" value="&lt;b&gt;Startup order&lt;/b&gt;&lt;br&gt;knowledge-init (one-shot, creates /knowledge dirs) → graphify + keycloak → api → knowledge-worker + web&lt;br&gt;&lt;br&gt;&lt;b&gt;Ports&lt;/b&gt;&lt;br&gt;web :3000 · api :8000 · keycloak :8080 · graphify :8001 (internal) · neo4j :7474 / :7687&lt;br&gt;&lt;br&gt;&lt;b&gt;Overlays / profiles&lt;/b&gt;&lt;br&gt;• docker-compose.synthetic.yml — graphify-mock + mock LLM + PL/SQL fixtures (make e2e)&lt;br&gt;• compose/postgres.yml — PostgreSQL conversation backend&lt;br&gt;• docker-compose-plsql.yml — PL/SQL-focused stack&lt;br&gt;• profile legacy-single-project — knowledge-ingest + knowledge/input&lt;br&gt;&lt;br&gt;&lt;b&gt;Hardening&lt;/b&gt;: cap_drop ALL · no-new-privileges · read-only Graphify root · /knowledge mounted ro in graphify" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="gComp">
          <mxGeometry x="15" y="35" width="400" height="335" as="geometry" />
        </mxCell>
        <mxCell id="r_graphify" value="&lt;b&gt;Graphify 0.9.18 MCP runtime&lt;/b&gt; (container graphify · :8001 /mcp)&lt;br&gt;official open-source runtime · authoritative entity/relationship graph&lt;br&gt;read-only /knowledge mount · synthetic overlay swaps in graphify-mock" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1810" y="470" width="430" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r_llm" value="&lt;b&gt;LLM provider&lt;/b&gt; (server-side keys only)&lt;br&gt;OpenAI-compatible endpoint via LiteLLM · answer + follow-up generation&lt;br&gt;also used by the worker for Graphify semantic extraction (OPENAI_API_KEY)&lt;br&gt;LLM_ADAPTER=mock → deterministic answers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1810" y="600" width="430" height="100" as="geometry" />
        </mxCell>
